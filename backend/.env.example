# Backend Environment Variables
# This file is a template. Copy to .env and update sensitive values.

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace-with-a-secure-secret
NODE_ENV=development

# Bind to all local network interfaces so LAN devices can reach the API.
# Do not set this to localhost in production or when testing from another device.
BIND_HOST=0.0.0.0
