# Frontend Environment Variables
# This file is used as a template. Copy to .env and update values.

# In local development, set the backend API if you need an explicit override.
# Most of the time the app will auto-detect the correct backend URL.
# For local dev on the same machine, use:
VITE_API_URL=http://localhost:5000

# If you serve the frontend from a LAN IP or on a mobile device connected to the same network,
# it is usually better to leave VITE_API_URL unset and let the app use the current origin.
# For production deployment, set this to the live API host if the frontend is not served from the same origin.
# VITE_API_URL=https://api.example.com
